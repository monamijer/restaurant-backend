# Copy to .env and fill in the values. Never commit .env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=restaurant
DB_USER=restaurant_user
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

CORS_ALLOWED_ORIGINS=http://localhost:5173

JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7


# The simulated payment gateway approves almost any token. It is on by default in DEBUG;
# outside development set this to True deliberately (e.g. for an academic demo).
ALLOW_SIMULATED_PAYMENTS=True


# Where the Vue app is served: used in password reset links and table QR codes.
FRONTEND_URL=http://localhost:5173
# Reset links stay valid for this long (seconds).
PASSWORD_RESET_TIMEOUT_SECONDS=3600
# E-mail: in development (DEBUG=True) messages are printed in the server console.
# In production set an SMTP server:
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Restaurant <no-reply@example.com>